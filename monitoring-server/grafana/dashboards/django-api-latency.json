    {
      "type": "table",
      "id": 12,
      "title": "Endpoints consuming the most wall-time",
      "description": "Sum of all latencies / interval = seconds of work per second. Combines volume × duration — fixing the top entry frees up the most total processing time. This is usually the best 'where to optimize' signal.",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 6 },
      "fieldConfig": {
