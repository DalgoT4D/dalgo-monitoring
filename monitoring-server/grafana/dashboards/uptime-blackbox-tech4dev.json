{
  "title": "Uptime - Tech4Dev",
  "uid": "uptime-blackbox-tech4dev",
  "tags": ["uptime", "blackbox", "tech4dev"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": { "hidden": true },
  "templating": { "list": [] },
  "panels": [
    { "id": 500, "type": "row", "title": "Tech4Dev · Production", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },

    { "id": 501, "type": "stat", "title": "Targets", "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "f65de527-42f9-4a12-9574-d16d4447b446" },
      "targets": [{ "refId": "A", "expr": "count(probe_success{job=\"blackbox_http\", subset=\"tech4dev\", env=\"production\"})" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "unit": "none" } },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" } },

    { "id": 502, "type": "stat", "title": "Up", "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "f65de527-42f9-4a12-9574-d16d4447b446" },
      "targets": [{ "refId": "A", "expr": "count(probe_success{job=\"blackbox_http\", subset=\"tech4dev\", env=\"production\"} == 1) or vector(0)" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "none" } },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" } },

    { "id": 503, "type": "stat", "title": "Down", "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "f65de527-42f9-4a12-9574-d16d4447b446" },
      "targets": [{ "refId": "A", "expr": "count(probe_success{job=\"blackbox_http\", subset=\"tech4dev\", env=\"production\"} == 0) or vector(0)" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" } },

    { "id": 504, "type": "stat", "title": "Uptime - 30 days (%)", "timeFrom": "30d", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "f65de527-42f9-4a12-9574-d16d4447b446" },
      "targets": [{ "refId": "A", "expr": "sort(avg_over_time(probe_success{job=\"blackbox_http\", subset=\"tech4dev\", env=\"production\"}[30d]) * 100)", "legendFormat": "{{instance}}", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 99 }, { "color": "yellow", "value": 99.5 }, { "color": "green", "value": 99.9 }] } } },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } } },

    { "id": 505, "type": "stat", "title": "Uptime - 24h (%)", "timeFrom": "24h", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "f65de527-42f9-4a12-9574-d16d4447b446" },
      "targets": [{ "refId": "A", "expr": "sort(avg_over_time(probe_success{job=\"blackbox_http\", subset=\"tech4dev\", env=\"production\"}[24h]) * 100)", "legendFormat": "{{instance}}", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 99 }, { "color": "yellow", "value": 99.5 }, { "color": "green", "value": 99.9 }] } } },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } } },

    { "id": 506, "type": "timeseries", "title": "Probe status (1 up / 0 down)", "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "f65de527-42f9-4a12-9574-d16d4447b446" },
      "targets": [{ "refId": "A", "expr": "probe_success{job=\"blackbox_http\", subset=\"tech4dev\", env=\"production\"}", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20, "showPoints": "never", "spanNulls": true } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } } },

    { "id": 507, "type": "timeseries", "title": "Response time (last 1h)", "timeFrom": "1h", "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "f65de527-42f9-4a12-9574-d16d4447b446" },
      "targets": [{ "refId": "A", "expr": "probe_duration_seconds{job=\"blackbox_http\", subset=\"tech4dev\", env=\"production\"}", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never" } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } } }
  ]
}
