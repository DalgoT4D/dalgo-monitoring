# ---- Public hostname for Grafana ----
# Served by the existing tech4dev-internal ALB; DNS must point this name at the
# ALB DNS (CNAME / Route53 ALIAS) before first use.
GRAFANA_HOSTNAME=monitoring.projecttech4dev.org

# ---- Grafana admin (used only on first boot before Google OAuth is set up) ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-on-first-boot

# ---- Grafana Google OAuth ----
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<GRAFANA_HOSTNAME>/login/google
GF_AUTH_GOOGLE_CLIENT_ID=
GF_AUTH_GOOGLE_CLIENT_SECRET=

# ---- SMTP (for Grafana alerting email contact point) ----
# Examples:
#   Gmail/Workspace:  smtp.gmail.com:587  (use an app password, not your real one)
#   AWS SES:          email-smtp.us-east-1.amazonaws.com:587
#   Mailgun:          smtp.mailgun.org:587
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=alerts@projecttech4dev.org
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=alerts@projecttech4dev.org
GF_SMTP_FROM_NAME=Dalgo Alerts
# OpportunisticStartTLS | MandatoryStartTLS | NoStartTLS
GF_SMTP_STARTTLS_POLICY=OpportunisticStartTLS

# ---- Grafana metadata database (existing RDS) ----
# Create on the RDS first:
#   CREATE DATABASE grafana;
#   CREATE USER grafana WITH PASSWORD '...';
#   GRANT ALL PRIVILEGES ON DATABASE grafana TO grafana;
#   \c grafana
#   GRANT ALL ON SCHEMA public TO grafana;
GF_DATABASE_HOST=<rds-host>:5432
GF_DATABASE_NAME=grafana
GF_DATABASE_USER=grafana
GF_DATABASE_PASSWORD=
# disable | require | verify-ca | verify-full
GF_DATABASE_SSL_MODE=require

# ---- postgres_exporter -> Dalgo prod RDS ----
# Create a read-only monitoring user on the RDS first.
DATA_SOURCE_NAME=postgresql://monitor:CHANGE_ME@<rds-host>:5432/postgres?sslmode=require

# ---- Prometheus scrape targets ----
# Private IP or hostname of the prod EC2 (where node_exporter + celery_exporter run).
PROD_EC2_HOST=10.0.0.0
